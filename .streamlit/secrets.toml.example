# Copy this file to .streamlit/secrets.toml and fill in your values.
# secrets.toml is listed in .gitignore, so it is never committed.
# On Streamlit Community Cloud, paste the same lines into App settings -> Secrets instead.

# From https://app.minimoth.dev -> your project -> Settings.
# mm_test_... = sandbox (no real message sent, the code is always 000000)
# mm_live_... = real WhatsApp/SMS codes (Rs 0.35 each)
MINIMOTH_API_KEY = "mm_test_your_key_here"

# Only these numbers can sign in. Indian mobiles, with or without +91.
AUTHORIZED_PHONES = "+919876543210, +919123456789"
